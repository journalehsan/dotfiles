#!/bin/bash
# Script to launch VMware Horizon View in Xephyr (nested X11 server)
# This avoids Wayland crashing issues by running in a dedicated X11 window.

# Check if Xephyr is installed
if ! command -v Xephyr &> /dev/null; then
    echo "Xephyr could not be found. Please install xorg-server-xephyr."
    exit 1
fi

# Define Display Number
DISPLAY_NUM=":2"

# Start Xephyr
# -screen 1920x1080 : Set window size
# -resizeable : Allow window resizing
# -retro : Starts with classic stipple and cursor (ensures cursor is visible)
echo "Starting Xephyr on $DISPLAY_NUM..."
Xephyr $DISPLAY_NUM -screen 1920x1080 -resizeable -retro &
XEPHYR_PID=$!

# Wait for Xephyr to initialize
sleep 1

# Set cursor if xsetroot is available (install xorg-xsetroot if missing)
if command -v xsetroot &> /dev/null; then
    env DISPLAY=$DISPLAY_NUM xsetroot -cursor_name left_ptr
fi

# Start VMware Horizon Client on the Xephyr display
echo "Starting VMware Horizon Client..."
# Force X11 backend and use Adwaita cursor as fallback
env DISPLAY=$DISPLAY_NUM GDK_BACKEND=x11 XCURSOR_THEME=Adwaita /usr/bin/vmware-view "$@"

# Cleanup: Kill Xephyr when VMware closes
echo "Closing Xephyr..."
kill $XEPHYR_PID
